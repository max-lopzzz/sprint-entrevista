# Copia estas variables en Vercel: Project → Settings → Environment Variables.
# NO subas un archivo .env con la key real al repo.

# Obligatoria. API key del proveedor de IA.
# Groq es gratis y no pide tarjeta: https://console.groq.com/keys
LLM_API_KEY=

# Opcionales — por defecto: Groq + openai/gpt-oss-120b (open weights, gratis en Groq).
# Alternativa más rápida: openai/gpt-oss-20b
# NOTA: los modelos Llama en Groq pasaron a tier enterprise y ya no son gratis.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
